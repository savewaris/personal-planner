{
    "name": "my-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "postinstall": "prisma generate",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "jest",
        "test:e2e": "playwright test",
        "db:seed": "npx tsx prisma/seed.ts",
        "agent:doctor": "node scripts/agent-doctor.mjs",
        "agent:state": "node scripts/agent-state.mjs",
        "test:ui": "playwright test",
        "test:ui:headed": "playwright test --headed",
        "test:ui:report": "playwright show-report"
    },
    "prisma": {
        "seed": "npx tsx prisma/seed.ts"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "framer-motion": "^13.1.1",
        "mermaid": "^11.17.2",
        "next": "16.3.3",
        "next-auth": "^4.24.15",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4",
        "@types/jest": "^30.0.0",
        "@types/node": "^26",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^10.9.1",
        "eslint-config-next": "16.3.3",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0",
        "prisma": "^7.10.0",
        "tailwindcss": "^4",
        "ts-jest": "^29.4.12",
        "tsx": "^4.23.13",
        "typescript": "^7"
    }
}
